= tag.div(class: [ \
            'image-card',
            { "image-card--#{@image_object[:type]}" => @image_object[:type].present?,
              hidden: @image_object.blank?,
              selected: @selected }],
          data: { \
            controller: 'image-card',
            "#{@form_controller_id}-target" => \
              ("imageCard #{@form_controller_target}" if @form_controller_id),
            action: ('click->image-card#toggleSelected' if @model == 'AdwordsAd') })
  
  = render('shared/loading_spinner') if @uploadable

  - form_controls.each do |control|
    = control

  - if @model == 'AdwordsAd'
    .image-card__frame
      .thumbnail
        img src="#{@image_object[:image_url]}" alt="#{alt_text}"
        .check
          div
            div
            span.fa-stack.fa-lg
              i.fa.fa-circle-o.fa-stack-2x
              i.fa.fa-check.fa-stack-1x

  - else
    .form-group data-image-card-target="formGroup"
      
      = tag.div(**fileinput_widget_attributes) do
        .image-card__header
          - if @uploadable
            button type="button" data-trigger="fileinput"
              i.fa.fa-fw class="fa-#{@model == 'User' ? 'camera' : 'upload'}"
          = header_actions
          |&nbsp;
          /button.btn-remove type="button" data-dismiss="fileinput"
            i.fa.fa-fw.fa-remove
        
        .image-card__frame
          - if @uploadable
            .fileinput-new.thumbnail
              = image_tag(placeholder_url, alt: alt_text)
            .fileinput-preview.fileinput-exists.thumbnail data-image-card-target="preview"
              - if image_exists?
                = image_tag(@image_object[:image_url] || @image_object[:url], alt: alt_text)
          - else
            .thumbnail
              = image_tag(@image_object[:image_url], alt: alt_text)
          .btn-file
            = tag.input( \
                type: 'file',
                accept: 'image/jpeg,image/png',
                data: { \
                  image_card_target: 'fileInput',
                  action: 'invalid->image-card#onInvalidImage',
                  asset_host: asset_host(),
                  s3: (s3_direct_post if @uploadable),
                  collection: @collection,
                  image_type: @image_object[:type],
                  max_file_size: AdwordsImage::MAX_FILE_SIZE,
                  min_dimensions: min_dimensions(@image_object[:type]),
                  required_image: ('true' if @required) })

        .image-card__footer
          = footer_actions
            
      .help-block.help-block--validation data-image-card-target="helpBlock"