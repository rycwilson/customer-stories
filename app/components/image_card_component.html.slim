= tag.div(class: [ \
            'image-card',
            { "image-card--#{@image_data[:type]}" => @image_data[:type].present?,
              'gads-default' => default_ad_image?,
              hidden: @model == 'AdwordsImage' && @image_data.blank?,
              selected: @selected }],
          data: { \
            image_id: @image_data[:id],
            controller: 'image-card',
            "#{@form_controller_id}-target" => ('imageCard' if @form_controller_id),
            image_card_upload_enabled_value: @upload_enabled,
            ads_target:,
            story_settings_target: 'ogImageCard',
            action: ('click->image-card#toggleSelected' if @model == 'AdwordsAd') })
  
  = render('shared/loading_spinner') if @upload_enabled

  / Hidden input tags for a given model
  = content

  - if @model == 'AdwordsAd'
    .image-card__frame
      .thumbnail
        img src="#{@image_data[:image_url]}" alt="#{alt_text}"
        .check
          div
            div
            span.fa-stack.fa-lg
              i.fa.fa-circle-o.fa-stack-2x
              i.fa.fa-check.fa-stack-1x

  - else
    .form-group data-image-card-target="formGroup"
      
      = tag.div(class: "fileinput fileinput-#{image_exists? ? 'exists' : 'new'}",
                data: { image_card_target: 'fileInputWidget' }) do
        
        .image-card__header
          - if @upload_enabled
            / attaching data-trigger attribute to .fileinput-preview does not work
            button type="button" data-trigger="fileinput"
              i.fa.fa-fw class="fa-#{@model == 'User' ? 'camera' : 'upload'}"
          - elsif secondary_ad_image?
            button.make-default type="button" data-action="image-card#makeDefault"
              i.fa.fa-fw.fa-refresh
            |&nbsp;
            button.btn-remove type="button" data-action="image-card#deleteImage"
              i.fa.fa-fw.fa-remove
          |&nbsp;
          /button.btn-remove type="button" data-dismiss="fileinput"
            i.fa.fa-fw.fa-remove

        .image-card__frame
          - if image_replaceable?
            .fileinput-new.thumbnail
              = image_tag(placeholder_url, alt: alt_text)
            .fileinput-preview.fileinput-exists.thumbnail data-image-card-target="preview"
              - if image_exists?
                = image_tag(@image_data[:image_url] || @image_data[:url], alt: alt_text)
          
          / only non-default company ad images are not replaceable
          - elsif @image_data[:image_url].present?
            .thumbnail
              = image_tag(@image_data[:image_url], alt: alt_text)
          - else
            .fileinput-preview.fileinput-exists.thumbnail data-image-card-target="preview"
          .btn-file
            = tag.input(type: 'file',
                        accept: 'image/jpeg,image/png',
                        data: { \
                          image_card_target: 'fileInput',
                          action: 'invalid->image-card#onInvalidImage',
                          asset_host: asset_host(),
                          s3: (s3_direct_post if @upload_enabled),
                          collection: @collection,
                          image_type: @image_data[:type],
                          max_file_size: AdwordsImage::MAX_FILE_SIZE,
                          min_dimensions: (min_dimensions unless @model == 'Customer'),
                          required_image: ('true' if @required) })

        - if secondary_ad_image?
          .image-card__footer
            button.btn.btn-sm.btn-default type="button" data-action="image-card#cancelChanges"
              | Cancel
            button.btn.btn-sm.btn-danger type="submit"
              | Delete
            button.btn.btn-sm.btn-success type="submit"
              | Make default

      .help-block.help-block--validation data-image-card-target="helpBlock"