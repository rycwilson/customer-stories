.form-horizontal 

  .form-group data-action="change->table-display-options#handleChangeCurator"
    label.control-label for="contributions-curator" Curator
    div 
      = render( \
          'companies/shared/curator_select',
          company:,
          ctrl_id: 'table-display-options',
          select_id: 'contributions-curator' )

  .form-group data-action="change->table-display-options#handleRowGroupColumnChanged"
    label.control-label Group 
    div 
      - [ ['1', 'Contributor'],
          ['2', 'Customer'],
          ['3', 'Customer Win'],
          ['', 'None'] ].each do |(column, label_text)|
        .radio 
          label
            = tag.input( \
                type: 'radio',
                name: 'contributions-row-group-column',
                value: column,
                checked: \
                  (true if column == row_group_column || column.blank? && row_group_column.nil?))
            = label_text

  .form-group data-action="change->table-display-options#handleChangeFilter"
    label.control-label Show 
    div 
      .checkbox 
        label for="show-completed"
          input#show-completed type="checkbox" checked="true" 
          | Contributors with a completed Contribution
      .checkbox 
        label for="show-published"
          input#show-published type="checkbox" checked="true" 
          | Contributors to published Customer Stories