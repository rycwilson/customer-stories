- template = local_assigns.fetch(:template, nil)
- is_default = company.invitation_templates.default.include?(template)

/ A dynamic select element id will ensure focus is not retained when element is replaced 
/ (initializing tomselect when focused will result in an auto-opened dropdown)
- select_id = SecureRandom.urlsafe_base64(8)

.form-group
  .visible-sm-block.col-sm-12
    label for=select_id
      | Template
  label.control-label.col-md-2.visible-md-inline-block.visible-lg-inline-block for=select_id
    | Template
  .col-sm-12.col-md-10
    .invitation-template__toolbar
      
      / Do not include the clear button plugin initially, else it will flicker when loading
      = select_tag( \
          '',
          invitation_template_select_options(company, template),
          { include_blank: template&.new_record? ? "– New Template –" : 'Select template',
            id: select_id,
            class: 'form-control',
            name: nil,
            data: { \
              controller: 'tomselect',
              tomselect_invitation_template_outlet: '#invitation-template-form',
              tomselect_kind_value: 'invitationTemplate',
              tomselect_custom_options_value: template&.persisted? ? {} : { plugins: {} },
              invitation_template_target: 'templateSelect',
              action: 'invitation-template#onChangeTemplate' }})

      - if template.present?
        .btn-group data-invitation-template-target="btnGroup"
          - if is_default
            button.invitation-template__restore.btn.btn-default {
              type="button" 
              data-action="company-settings#restoreInvitationTemplate"
              data-controller="tooltip"
              data-tooltip-options-value={ title: 'Restore to factory default' }.to_json }
              i.fa.fa-fw.fa-rotate-left
          - if template&.persisted?
            = link_to( \
                new_company_invitation_template_path(company) + "?source_template_id=#{template.id}",
                class: 'btn btn-default', 
                aria: { label: 'Duplicate Template' },
                data: { \
                  turbo_stream: true,
                  controller: 'tooltip',
                  tooltip_options_value: { title: 'Duplicate' }.to_json }) do
                i.fa.fa-fw.fa-copy
          - unless is_default
            button.invitation-template__delete.btn.btn-default {
              type="button" 
              data-action="invitation-template##{template.persisted? ? 'delete' : 'discard'}"
              data-controller="tooltip"
              data-tooltip-options-value={ title: template.persisted? ? 'Delete' : 'Discard' }.to_json }
              i.fa.fa-fw.fa-remove
        = tag.button( \
            class: 'form__submit btn btn-success btn-sm',
            style: 'padding: 7px 14px',
            disabled: true,
            data: { \
              content: template.new_record? ? 'Create' : 'Save changes',
              invitation_template_target: 'submitBtn',
              disable_with_html: disabled_submit_button_html })

      = link_to( \
          new_company_invitation_template_path(company),
          class: "btn btn-secondary #{'hidden' if template.present?}", 
          aria: { label: 'New Invitation Template' },
          data: { turbo_stream: true, invitation_template_target: 'newTemplateBtn' }) do
          i.fa.fa-plus
          |&nbsp;&nbsp;New