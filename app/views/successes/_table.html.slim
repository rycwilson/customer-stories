= tag.table(id: 'successes-table',
            class: 'table',
            data: { \
              controller: 'datatable',
              customer_wins_target: 'table',
              datatable_resource_id_value: 'customer-wins',
              action: [ \
                'customer-win:delete-row->datatable#deleteRow'].join(' '),
              aria_labelledby: 'customer-wins-table-caption' }) do

  / NOTE: The current user is the curator for a new Customer Win, not the curator_id filter
  = render(ResourceControlsComponent.new( \
      'customer-wins',
      search_options: company.successes.search_options,
      new_resource_path: new_company_success_path(company) ))

  thead
    tr
      th
        i.fa.fa-rocket
      th.customer Customer
      th.customer-win Customer Win
      th Curator
      th.status Status
      th Story
      th

.row-view data-customer-wins-target="rowView"