- tomselect_data = ->(kind) { { controller: 'tomselect', tomselect_kind_value: kind } }
- select_options = { include_blank: true, class: 'stories-filter__select form-control' }

.form-horizontal

  .form-group data-action="change->display-options#handleCuratorChanged"
    label.control-label for="stories-curator" Curator
    div
      = select_tag( \
          nil,
          options_from_collection_for_select(company.curators, :id, :curator_name_with_stories_count),
          select_options.merge(id: 'stories-curator', placeholder: 'Select curator', data: tomselect_data.('curator')))

  .form-group data-action="change->display-options#handleFilterChanged"
    label.control-label for="stories-status" Status
    div
      = select_tag( \
          nil,
          options_for_select( \
            Story.status_news.map { |k, v| k == 'is_published' ? \
              ["Published (#{company.stories.is_published.count})", v] : \
              ["#{k.capitalize} (#{company.stories.send(k).count})", v] }),
          select_options.merge(id: 'stories-status', placeholder: 'Select status', data: tomselect_data.('status')))

  .form-group data-action="change->display-options#handleFilterChanged"
    label.control-label for="stories-customer" Customer
    div
      = select_tag( \
          nil,
          options_from_collection_for_select(company.customers, :id, :name_with_stories_count),
          select_options.merge(id: 'stories-customer', placeholder: 'Select customer', data: tomselect_data.('customer')))

  - %i[category product].each do |kind|
    .form-group data-action="change->display-options#handleFilterChanged"
      label.control-label for="stories-#{kind}" = kind.to_s.capitalize
      div
        = select_tag( \
            nil,
            options_for_select(company.tag_select_options(tag, only_featured: false)),
            select_options.merge(id: "stories-#{kind}", placeholder: "Select #{kind}", data: tomselect_data.(kind)))

  .form-group data-action="change->display-options#handleChangeMatchType"
    label.control-label Match
    div
      - %w[all any].each do |type|
        label.radio-inline
          = tag.input(type: 'radio', name: 'stories-match-type', value: type, checked: type == match_type)
          = type

  .form-group
    div
      button.btn-link type="button" data-action="display-options#clearFilters"
        | Clear all
