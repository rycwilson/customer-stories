main.dashboard.hidden-xs data-controller="dashboard" data-dashboard-modal-outlet="#main-modal"

  = render('shared/navbars/company_nav', company: @company, workflow_stage: 'story')

  = tag.div( \
      id: 'story',
      data: { \
        controller: 'story',
        dashboard_target: 'story',
        action: [ \
          'contributions:loading->dashboard#onResourceLoading',
          'contributions:ready->dashboard#onResourceReady' ].join(' ') }) do

    = render('shared/loading_spinner')

    .company__container.container-fluid
    
      .sidebar data-dashboard-target="sidebar"
        .sidebar__toggle
          .thingy
          button.btn.btn-default type="button" data-action="dashboard#toggleSidebar"
            i.fa.fa-bars

        ul.nav
          li
            = link_to dashboard_path('curate') do 
              i.fa.fa-fw.fa-chevron-left
              span All Stories
            end

          - [ ['#story-narrative-content', 'fa-edit', 'Narrative Content'],
              ['#story-testimonials', 'fa-quote-left', 'Testimonials'],
              ['#story-contributions', 'fa-users', 'Contributors'],
              ['#story-settings', 'fa-gear', 'Settings'] ].each do |panel_id, icon_class, label| 
              
            li class=('active' if @active_tab == panel_id)
              = tag.a(id: "#{panel_id.sub('#', '')}-tab",
                      href: panel_id,
                      role: 'tab',
                      data: { toggle: 'tab', action: 'dashboard#setNavCookie' },
                      aria: { \
                        controls: panel_id.sub('#', ''),
                        expanded: (@active_tab == panel_id) }) do
                i.fa.fa-fw class=icon_class
                span = label

      .company__main
        .tab-content

          #story-narrative-content.tab-pane {
            class=('active in' if @active_tab == '#story-narrative-content')
            aria-labelledby="story-narrative-content-tab"
            role="tabpanel" }
            = render('/stories/edit/narrative_content', { company: @company, story: @story })
            
          #story-testimonials.tab-pane {
            class=('active in' if @active_tab == '#story-testimonials')
            aria-labelledby="story-testimonials-tab"
            role="tabpanel" }
            = render('stories/edit/testimonials', { company: @company, story: @story })
            
          #story-contributions.tab-pane {
            class=('active' if @active_tab == '#story-contributions') 
            data-resource-name="storyContributions"
            data-story-id=@story.id
            data-story-target="contributions"
            data-controller="contributions"
            data-contributions-init-value="true"
            data-contributions-data-path-value=success_contributions_path(@story.success)
            data-contributions-row-group-data-source-value=""
            data-contributions-filters-value=contributions_filters(@story.curator.id).to_json
            aria-labelledby="story-contributions-tab"
            role="tabpanel" }
            
            = render('contributions/table', company: @company, story: @story)

          #story-settings.tab-pane {
            class=('active' if @active_tab == '#story-settings')
            aria-labelledby="story-settings-tab"
            role="tabpanel" }
            
            = render('stories/edit/story_settings', { company: @company, story: @story })

