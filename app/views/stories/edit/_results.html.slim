= tag.div( \
    # id attribute is necessary for turbo stream replace action,
    id: 'customer-results',
    class: 'crud-list',
    data: { \
      controller: 'list',
      list_new_item_field_name_value: 'story[new_results][]' }) do

  .crud-list__new-item
    .input-group
      = tag.input( \
          class: 'form-control',
          placeholder: 'Add a key customer result to be highlighted with the story',
          minlength: 5,
          maxlength: 20,
          data: { \
            list_target: 'newItemInput',
            story_narrative_content_target: 'newResultInput',
            action: [ 'list#onInputNewItem' ].join(' ') })
      .input-group-addon.hidden
        = tag.button( \
            type: 'button',
            class: 'btn btn-default',
            data: { \
              controller: 'tooltip',
              tooltip_options_value: { title: 'Discard', delay: { show: 500, hide: 0 } },
              action: 'list#cancelNewItem' }) do
          | &times;
    = tag.button( \
        type: 'submit',
        class: 'btn btn-sm btn-success hidden',
        style: 'padding: 7px 12px',
        data: { \
          content: 'Add Result',
          list_target: 'newItemSubmit',
          story_narrative_content_target: 'newResultSubmit',
          field_name: 'story[new_results][]',
          disable_with_html: disabled_submit_button_html })
  .help-block
    | Must be between MIN and MAX characters

  = tag.ol( \
      class: [ \
        'list-group list-unstyled',
        { 'hidden': cookies["csp-hide-results-#{story.id}"],
          'list-group--sortable': story.new_results.count > 1 }],
      data: { \
        list_target: 'list',
        story_narrative_content_target: 'resultsList' })

    /= form.fields_for(:results) do |result_fields|
    - story.new_results.each_with_index do |result, i|
      = tag.li(class: 'list-group-item', data: { list_target: 'item' }) do

        .list-group-item__item

          - if story.new_results.count > 1
            .list-group-item__handle data-list-target="sortHandle"
              = tag.i(class: 'fa fa-fw fa-arrows-v')
          
          .list-group-item__content
            p
              = result
            .input-group
              = text_field_tag( \
                  "story[new_results][]",
                  result,
                  id: "story_new_results_#{i}",
                  class: 'form-control',
                  data: { \
                    list_target: 'itemInput',
                    initial_value: result })
              .input-group-addon
                = tag.button( \
                    type: 'button',
                    class: 'btn btn-default',
                    data: { \
                      controller: 'tooltip',
                      tooltip_options_value: { title: 'Discard changes', delay: { show: 500, hide: 0 } },
                      list_target: 'cancelButton',
                      action: 'list#cancelEdit' }) do
                  | &times;
            = tag.button( \
                type: 'submit',
                class: 'btn btn-sm btn-success',
                style: 'padding: 7px 12px',
                # disabled: true,
                data: { \
                  content: 'Save changes',
                  field_name: "story[new_results][]",
                  disable_with_html: disabled_submit_button_html })

          .list-group-item__actions
            = tag.button(type: 'button', class: 'btn', data: { action: 'list#editItem' }) do
              i.fa.fa-fw.fa-pencil
            = tag.button(type: 'button', class: 'btn', data: { action: 'list#deleteItem' }) do
              i.fa.fa-fw.fa-trash