= tag.div(id:)
  - if cookies["csp-hide-customer-results-#{story.id}"] || story.new_results.count >= 3
    = button_tag( \
        "#{cookies["csp-hide-customer-results-#{story.id}"] ? 'Show' : 'Hide'} #{story.new_results.count}",
        type: 'button',
        class: 'btn btn-link',
        data: { \
          story_id: story.id,
          story_narrative_content_target: 'toggleResultsButton',
          action: 'story-narrative-content#toggleResults' })