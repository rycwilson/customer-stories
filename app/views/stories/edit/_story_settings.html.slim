= turbo_frame_tag('story-settings-frame') do

  = form_with( \
      model: story,
      id: 'story-settings-form',
      class: 'form-horizontal', 
      data: { \
        controller: 'story-settings toast',
        toast_flash_value: (flash.to_h if flash.any? && turbo_frame_request_id == 'story-settings-frame'),
        toast_errors_value: (@errors if @errors.present? && turbo_frame_request_id == 'story-settings-frame'),
        action: [ \
          'image-card:ready-to-validate->story-settings#updateValidator',
          'image-card:validated->story-settings#updateValidator',
          'image-card:upload-ready->story-settings#submitForm',
          'change->story-settings#submitForm',
          'bootstrap-switch:switch->story-settings#submitForm',
          'turbo:submit-end->story-settings#resetForm' ].join(' ') },
      html: { \
        novalidate: true,
        autocomplete: 'off' }) do |form|

    = form.fields_for(:success) do |success_fields|

      .hidden-link.form-group
        .visible-sm-block.col-sm-12
          = form.label(:hidden_link, 'Private Link')
        = form.label( \
            :hidden_link,
            'Private Link',
            class: 'control-label visible-md-inline-block visible-lg-inline-block col-md-4')
        .col-sm-12.col-md-8
          .input-group
            = form.text_field( \
                :hidden_link,
                { class: 'form-control',
                  placeholder: 'Click the Refresh button to generate a URL',
                  readonly: true,
                  data: { story_settings_target: 'hiddenLinkInput' }})
            span.input-group-btn
              = button_tag( \
                  class: 'hidden-link__refresh btn btn-default',
                  type: 'button',
                  style: 'border-radius: 0; border-left: 0',
                  data: { \
                    controller: 'tooltip',
                    tooltip_options_value: { title: 'Refresh', container: 'body', placement: 'top' },
                    action: 'story-settings#refreshHiddenLink' }) do
                i.fa.fa-refresh
            span.input-group-btn
              = button_tag( \
                  class: "btn btn-default #{'disabled' if story.hidden_link.blank?}",
                  type: "button",
                  disabled: story.hidden_link.blank?,
                  data: { \
                    controller: "tooltip",
                    action: "story-settings#copyHiddenLink",
                    tooltip_options_value: { title: 'Copy to clipboard', container: 'body', placement: 'top' },
                    story_settings_target: "hiddenLinkCopyBtn" }) do
                i.fa.fa-clipboard
          span.help-block style="margin-bottom: 0"
            | Allows for viewing the story prior to publishing.

      .form-group
        .visible-sm-block.col-sm-12
          label for="story-tags-ts-control" Tags
        = tag.label( \
            'Tags',
            for: 'story-tags-ts-control',
            class: 'control-label visible-md-inline-block visible-lg-inline-block col-md-4')
        .col-md-8
          = select_tag( \
              'story_tags',
              grouped_options_for_select( \
                { 'Category' => company.tag_select_options(:category, with_stories_count: false, for_multi_select: true), 
                  'Product' => company.tag_select_options(:product, with_stories_count: false, for_multi_select: true) } \
                  .delete_if { |_, options| options.empty? },
                story.tags.map { |tag| tag_dom_id(tag) }),
              { id: 'story-tags',
                multiple: true,
                data: { \
                  controller: 'tomselect',
                  tomselect_kind_value: 'tag',
                  dynamic_placeholder: 'Select Tags' } })

      .form-group
        .visible-sm-block.col-sm-12
          = success_fields.label(:cta_ids, 'CTAs')
        = success_fields.label( \
            :cta_ids,
            'CTAs',
            class: 'control-label visible-md-inline-block visible-lg-inline-block col-md-4')
        .col-sm-12.col-md-8
          = success_fields.grouped_collection_select( \
              :cta_ids,
              company.ctas.group_by(&:type).map do |type, ctas| \
                [type == 'CtaLink' ? 'Links' : 'Web Forms', ctas.sort_by(&:display_text)] \
              end,
              :second,
              :first,
              :id,
              :display_text,
              { include_blank: true },
              { multiple: true,
                class: 'form-control',
                data: { \
                  controller: 'tomselect',
                  tomselect_kind_value: 'cta',
                  dynamic_placeholder: 'Select CTAs' } })

    .og-tags.row
      .visible-sm-block.col-sm-12
        label Open Graph
      label.control-label.visible-md-inline-block.visible-lg-inline-block.col-md-4 Open Graph
      .col-sm-12.col-md-8
        .og-tags__background
          .form-group
            .col-sm-12
              = form.label(:og_title, 'Title')
              div
                = form.text_field( \
                    :og_title,
                    class: 'form-control',
                    maxlength: 90,
                    placeholder: 'og:title',
                    oninput: \
            "this.nextElementSibling.classList.toggle('hidden', this.value === this.dataset.initialValue)",
                    data: { \
                      story_settings_target: 'ogTitleInput',
                      initial_value: story.og_title })
                = button_tag( \
                    '',
                    type: 'submit',
                    class: 'btn btn-sm btn-success hidden',
                    style: 'padding: 7px 12px',
                    # disabled: true,
                    data: { \
                      content: 'Save changes',
                      disable_with_html: disabled_submit_button_html })

          .form-group
            .col-sm-12
              = form.label(:og_description, 'Description')
              div
                = form.text_area( \
                    :og_description,
                    class: 'form-control',
                    rows: 3,
                    maxlength: 200,
                    oninput: \
            "this.nextElementSibling.classList.toggle('hidden', this.value === this.dataset.initialValue)",
                    data: { \
                      story_settings_target: 'ogDescriptionTextarea',
                      initial_value: story.og_description })
                = button_tag( \
                    '',
                    type: 'submit',
                    class: 'btn btn-sm btn-success hidden',
                    style: 'padding: 7px 12px',
                    # disabled: true,
                    data: { \
                      content: 'Save changes',
                      disable_with_html: disabled_submit_button_html })

          .form-group
            .col-sm-12
              = form.label(:og_image_url, 'Image')
              = render( \
                  ImageCardComponent.new( \
                    'Story', 
                    image_data: { type: 'OpenGraph', url: story.og_image_url } )) do
                = form.hidden_field( \
                    :og_image_url,
                    disabled: true,
                    data: { image_card_target: 'input urlInput' })

    .row 
      .visible-md-inline-block.visible-lg-inline-block.col-md-4
      .col-sm-12.col-md-8
        hr

    .story-settings__publish.form-group
      .visible-sm-block.col-sm-12
        label Publish
      label.control-label.visible-md-inline-block.visible-lg-inline-block.col-md-4 Publish
      .col-sm-12.col-md-8
        div
          - { 'Customer' => :logo_published,
              'Preview' => :preview_published,
              'Story' => :published }.each do |label_text, attr| 
            = tag.div( \
                data: { \
                  controller: "bootstrap-switch #{'tooltip' if attr == :preview_published}",
                  bootstrap_switch_disabled_value: ('true' if attr == :preview_published),
                  tooltip_options_value: \
                    ({ title: 'Contact us', container: 'body' }.to_json if attr == :preview_published) }) do
              = form.label(attr, label_text)
              = form.check_box( \
                  attr,
                  class: 'form-control',
                  disabled: attr == :preview_published,
                  data: { \
                    bootstrap_switch_target: 'switch',
                    on_text: '&nbsp;&nbsp;&nbsp;',
                    off_text: '&nbsp;&nbsp;&nbsp;' })

    .story-settings__remove.form-group
      .visible-sm-block.col-sm-12
        label Remove
      label.control-label.visible-md-inline-block.visible-lg-inline-block.col-md-4 Remove
      .col-sm-12.col-md-8
        div
          button.btn.btn-secondary type="button"
            i.fa.fa-fw.fa-archive
            | &nbsp;&nbsp;
            | Archive this Story
          = link_to( \
              story_path(story),
              class: 'btn btn-danger--outline',
              data: { \
                turbo_method: 'delete',
                turbo_frame: '_top',
                turbo_confirm: 'Are you sure you want to delete this Story? This action cannot be undone.' }) do
              i.fa.fa-fw.fa-trash
              | &nbsp;&nbsp;
              | Delete this Story