#user-photo

  = render(ImageCardComponent.new( \
      'User',
      form_controller_id: 'user-profile',
      image_object: { type: 'UserPhoto', url: user.photo_url } )) do |component|

    - component.with_form_control do
      = hidden_field_tag( \
          'user[photo_url]',
          user.photo_url,
          id: 'user_photo_url',
          disabled: true,
          data: { image_card_target: 'input urlInput' })