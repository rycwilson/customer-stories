= turbo_stream.append('main-modal-body') do

  = form_with( \
      model: @customer,
      id: 'customer-form',
      data: { \
        controller: 'form',
        form_modal_outlet: '#main-modal',
        action: [ \
          'input->form#updateState',
          'image-card:upload-ready->form#updateState',
          'submit->form#validate',
          'turbo:submit-start->form#onSubmitStart',
          'turbo:submit-end->form#onSubmitEnd' ].join(' ') },
      html: { \
        novalidate: true,
        autocomplete: 'off' }) do |form|

    .form-group
      = form.label(:name, class: 'control-label')
      = form.text_field(:name, class: 'form-control', required: true)
      .help-block.help-block--validation

    .form-group
      = form.label(:description)
      = form.text_area(:description, class: 'form-control', style: 'width: 100%', rows: 4)

    .form-group.logo
      div
        = form.label(:logo_url, 'Logo')
        .checkbox
          = form.label(:show_name_with_logo)
            = form.check_box(:show_name_with_logo)
            = 'Show name'
      = render(ImageCardComponent.new( \
              'Customer',
              image_object: { url: @customer.logo_url },
              form_controller_id: 'form',
              auto_saves: false )) do |component|
        - component.with_form_control do
          .customer-name 
            span = @customer.name
          = form.hidden_field( \
              :logo_url,
              disabled: true,
              data: { image_card_target: 'input urlInput' })

= turbo_stream.append 'main-modal-content' do 
  .modal-footer data-modal-target="footer"
    button.btn.btn-default type="button" data-dismiss="modal" Cancel
    = tag.button( \
        class: 'form__submit btn btn-success disabled',
        form: 'customer-form',
        disabled: true,
        data: { content: 'Save changes', disable_with_html: disabled_submit_button_html })