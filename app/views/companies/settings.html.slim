= render('shared/navbars/company_nav', company: @company)

main.container-fluid.hidden-xs data-controller="company-settings"

  .sidebar
    / no active tab set here; it will be set by the client based on page fragment identifier
    ul.nav.nav--company data-controller="nav-list" role="tablist"
      - unless @company.new_record?
        li role="presentation"
          a {
            href="#contributor-invitations-panel" 
            role="tab"
            data-toggle="tab"
            data-company-settings-target="tab"
            data-nav-list-target="tab" }
            i.fa.fa-fw.fa-envelope-o
            |&nbsp;Contributor Invitations
        
        li role="presentation"
          a {
            href="#contributor-prompts-panel" 
            role="tab"
            data-toggle="tab"
            data-company-settings-target="tab"
            data-nav-list-target="tab" }
            i.fa.fa-fw.fa-lightbulb-o
            |&nbsp;Contributor Prompts

        li role="presentation"
          a {
            href="#website-plugin-panel" 
            role="tab"
            data-toggle="tab"
            data-company-settings-target="tab"
            data-nav-list-target="tab" }
            i.fa.fa-fw.fa-plug
            |&nbsp;Website Plugin
              
        li role="presentation"
          a {
            href="#cta-links-forms-panel" 
            role="tab"
            data-toggle="tab"
            data-company-settings-target="tab"
            data-nav-list-target="tab" }
            i.fa.fa-fw.fa-hand-pointer-o
            |&nbsp;CTA Links & Forms

        li role="presentation"
          a {
            href="#tags-panel" 
            role="tab"
            data-toggle="tab"
            data-company-settings-target="tab"
            data-nav-list-target="tab" }
            i.fa.fa-fw.fa-tags
            |&nbsp;Tags
      
      li role="presentation" 
        a href="#account-panel" data-toggle="tab" data-company-settings-target="tab" style="#{@company.new_record? ? 'pointer-events:none' : ''}"
          i.fa.fa-fw.fa-gear
          |&nbsp;Account Settings

  .layout-main
    .tab-content

      - unless @company.new_record?
          
        #contributor-invitations-panel.tab-pane role="tabpanel"
          #invitation-template-form.form-horizontal data-controller="invitation-template"
            = render('invitation_templates/template_toolbar', company: @company, errors: @errors)

        #contributor-prompts-panel.tab-pane role="tabpanel"
          = turbo_frame_tag('contributor-prompts-frame')
            = render('contributor_prompts', company: @company, errors: @errors)
        
        #website-plugin-panel.tab-pane role="tabpanel"
          = render('plugins/config', company: @company, errors: @errors)

        #cta-links-forms-panel.tab-pane role="tabpanel"
          = render('ctas', company: @company, errors: @errors)

        #tags-panel.tab-pane role="tabpanel"
          = render('companies/settings/tags', company: @company, errors: @errors)

      #account-panel.tab-pane role="tabpanel"
        = render('companies/settings/company_profile', company: @company, errors: @errors)