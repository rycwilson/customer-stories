= tag.div(class: 'dashboard hidden-xs',
          data: { \
            controller: 'dashboard',
            dashboard_active_tab_value: @workflow_stage,
            dashboard_modal_outlet: '#main-modal',
            dashboard_toast_outlet: '#toaster',
            dashboard_filters_value: @dashboard_filters,
            action: [ \
              'win-story:show-contributor->dashboard#showContributor',
              'toast->dashboard#showToast',
              'dashboard-filter-changed->dashboard#handleFilterChanged' ].join(' ') }) do

  = render('shared/navbars/company_nav', company: @company, workflow_stage: @workflow_stage)
  
  .tab-content data-dashboard-target="tabContent"
    = render('companies/dashboard/curate',
             company: @company,
             curator: @curator,
             workflow_stage: @workflow_stage,
             active_tab: @curate_active_tab,
             sidebar_collapsed: @sidebar_collapsed,
             stories_filters: @stories_filters,
             stories_filters_match_type: @stories_filters_match_type)

    = render('companies/dashboard/promote',
             company: @company,
             curator: @curator,
             workflow_stage: @workflow_stage,
             active_tab: @promote_active_tab,
             sidebar_collapsed: @sidebar_collapsed)

    = render('companies/dashboard/measure',
             company: @company,
             curator: @curator,
             workflow_stage: @workflow_stage,
             active_tab: @measure_active_tab,
             sidebar_collapsed: @sidebar_collapsed)