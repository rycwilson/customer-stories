= tag.div(id: "#{resource_id}-search",
          class: 'search-table',
          data: { \
            action: [ \
              "tomselect:change-search->#{resource_id}#handleSearchSelectChanged",
              "tomselect:search->#{resource_id}#handleTomselectSearched" ].join(' ') }) do
  
  = select_tag( \
      '',
      grouped_options_for_select(search_options),
      name: nil,
      include_blank: true,
      placeholder: 'Search',
      class: 'form-control',
      data: { \
        controller: 'tomselect', 
        tomselect_kind_value: 'search', 
        "#{resource_id}_target" => 'searchSelect',
        dashboard_target: "#{resource_id.underscore.camelize.sub(/\A./, &:downcase)}SearchSelect" })