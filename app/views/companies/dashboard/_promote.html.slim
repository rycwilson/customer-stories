= tag.div(id: 'promote',
          class: ['tab-pane', active: workflow_stage == 'promote'],
          role: 'tabpanel',
          data: { \
            dashboard_target: 'tabPanel',
            action: [ \
              'promoted-stories:loading->dashboard#handleResourceLoading',
              'promoted-stories:ready->dashboard#handleResourceReady' ].join(' ') }) do

  = spinner_html.html_safe

  .company__container.container-fluid
    = render(SidebarComponent.new( \
        'dashboard', active_tab:, collapsed: sidebar_collapsed)) do |component|
      - [ ['#promoted-stories', 'fa-bullhorn', 'Promoted Stories'],
          ['#promote-settings', 'fa-gear', 'Settings'] ] \
          .each do |panel_selector, icon_class, label_text|
        - component.with_tab( \
            panel_selector:,
            icon_class:,
            label_text:,
            data: { action: 'dashboard#setNavCookie', nav_list_target: 'tab' })
                  
    .company__main
      .tab-content
      
        = tag.div( \
            id: 'promoted-stories',
            class: ['tab-pane', active: active_tab == '#promoted-stories'],
            aria_labelledby: 'promoted-stories-tab',
            role: 'tabpanel',
            data: { \
              dashboard_target: 'promotedStories',
              controller: 'promoted-stories',
              promoted_stories_data_path_value: company_adwords_ads_path(company),
              promoted_stories_row_group_column_value: @row_group_columns['promoted_stories'],
              promoted_stories_filters_value: { 'curator': curator&.id },
              promoted_stories_filters_html_value: promoted_stories_filters_popover_html(company),
              promoted_stories_preferences_html_value: \
                promoted_stories_preferences_popover_html(company, @row_group_columns['promoted_stories']) }) do

          = tag.table(id: 'promoted-stories-table',
                      class: 'table',
                      data: { \
                        promoted_stories_target: 'table',
                        controller: 'datatable',
                        datatable_resource_id_value: 'promoted-stories',
                        promote_tr: company.promote_tr }) do
            = render(ResourceControlsComponent.new( \
                'promoted-stories',
                search_options: { 'Customer' => company.customers.map(&:select_option) }))
            thead
              tr
                th
                  i.fa.fa-bullhorn
                th.customer Customer
                th.story-title Story Title
                th.status Status
                th Curator
                th

        = tag.div(id: 'promote-settings',
                  class: ['tab-pane', active: active_tab == '#promote-settings'],
                  aria_labelledby: 'promote-settings-tab',
                  role: 'tabpanel',)
          = render('companies/dashboard/gads_form', company:, active_collection: 'images')