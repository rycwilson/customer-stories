= tag.div(id: 'promote',
          class: "tab-pane #{'active' if workflow_stage == 'promote'}",
          role: 'tabpanel',
          data: { \
            dashboard_target: 'tabPanel',
            action: [ \
              'promoted-stories:loading->dashboard#handleResourceLoading',
              'promoted-stories:ready->dashboard#handleResourceReady'].join(' ') }) do

  = spinner_html.html_safe

  .company__container.container-fluid
    = tag.div(class: ['sidebar', 'sidebar--collapsed': @sidebar_collapsed],
              data: { dashboard_target: 'sidebar' })
      .sidebar__toggle
        .thingy
        button.btn.btn-default type="button" data-action="dashboard#toggleSidebar"
          i.fa.fa-bars

      ul.nav data-controller="nav-list"
        - [ ['#promoted-stories', 'fa-bullhorn', 'Promoted Stories'],
            ['#promote-settings', 'fa-gear', 'Settings'] ].each do |panel_id, icon_class, label|
            
          li class="#{'active' if active_tab == panel_id}" role="presentation"
            = tag.a(href: panel_id,
                    role: 'tab',
                    data: { \
                      toggle: 'tab',
                      action: 'dashboard#setNavCookie',
                      controller: 'tooltip',
                      tooltip_options_value: nav_link_tooltip_options(label) },
                    aria: { \
                      controls: panel_id.sub('#', ''),
                      expanded: (active_tab == panel_id) }) do
              i.fa.fa-fw class=icon_class
              span = label
                  
    .company__main
      .tab-content
      
        = tag.div( \
            id: 'promoted-stories',
            class: ['tab-pane', active: active_tab == '#promoted-stories'],
            aria_labelledby: 'promoted-stories-tab',
            role: 'tabpanel',
            data: { \
              dashboard_target: 'promotedStories',
              resource_name: 'promotedStories',
              controller: 'promoted-stories',
              promoted_stories_dashboard_outlet: '.dashboard',
              promoted_stories_data_path_value: company_adwords_ads_path(company),
              promoted_stories_row_group_column_value: @row_group_columns[:promoted_stories],
              promoted_stories_filters_value: { 'curator': curator&.id },
              promoted_stories_display_options_html_value: \
                promoted_stories_display_options_html(company, @row_group_columns[:promoted_stories]) }) do

          = tag.table(id: 'promoted-stories-table',
                      class: 'table',
                      data: { \
                        promoted_stories_target: 'datatable',
                        controller: 'datatable',
                        datatable_resource_ctrl_id_value: 'promoted-stories',
                        promote_tr: company.promote_tr }) do

            = render('companies/shared/table_controls',
                     company:, 
                     caption: 'Promoted Stories',
                     resource_name: 'promotedStories',
                     resource_ctrl_id: 'promoted-stories',
                     search_options: { 'Customer' => company.customers.map(&:select_option) })

            thead
              tr
                th
                  i.fa.fa-bullhorn
                th.customer Customer
                th.story-title Story Title
                th.status Status
                th Curator
                th

        #promote-settings.tab-pane class=('active' if active_tab == '#promote-settings')
          = render('companies/dashboard/gads_form', company:, active_collection: 'images')