= tag.div(id: 'measure',
          class: "tab-pane #{'active' if workflow_stage == 'measure'}",
          role: 'tabpanel',
          data: { \
            dashboard_target: 'tabPanel',
            action: [ \
              'visitors:loading->dashboard#handleResourceLoading',
              'visitors:ready->dashboard#handleResourceReady',
              'activity:loading->dashboard#handleResourceLoading',
              'activity:ready->dashboard#handleResourceReady'].join(' ') }) do

  = spinner_html.html_safe

  .company__container.container-fluid
    = render(SidebarComponent.new( \
        'dashboard', active_tab:, collapsed: sidebar_collapsed)) do |component|
      - [ ['#visitors', 'fa-bar-chart', 'Visitors'],
          ['#activity', 'fa-line-chart', 'Recent Activity'] ] \
          .each do |panel_selector, icon_class, label_text|
        - component.with_tab( \
            panel_selector:,
            icon_class:,
            label_text:,
            data: { action: 'dashboard#setNavCookie', nav_list_target: 'tab' })

    .company__main
      .tab-content

        #visitors.tab-pane {
          class=('active in' if active_tab == '#visitors') 
          data-dashboard-target="visitors"
          data-resource-name="visitors"
          data-controller="visitors"
          data-visitors-dashboard-outlet=".dashboard"
          data-visitors-data-path-value=company_visitors_path(company)
          data-visitors-filters-value=@visitors_filters.to_json
          data-visitors-display-options-html-value=visitors_display_options_html(company)
          aria-labelledby="visitors-tab"
          role="tabpanel" }

          = render('companies/measure/visitors', company:)

        #activity.tab-pane {
          class=('active in' if active_tab == '#activity')
          data-dashboard-target="activity"
          data-resource-name="activity"
          data-controller="activity"
          data-activity-dashboard-outlet=".dashboard"
          data-activity-filters-value={ 'curator': curator&.id }.to_json
          aria-labelledby="activity-tab"
          role="tabpanel" }

          = render('companies/measure/activity')