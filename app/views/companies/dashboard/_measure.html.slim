= tag.div(id: 'measure',
          class: "tab-pane #{'active' if workflow_stage == 'measure'}",
          role: 'tabpanel',
          data: { \
            dashboard_target: 'tabPanel',
            action: [ \
              'visitors:loading->dashboard#handleResourceLoading',
              'visitors:ready->dashboard#handleResourceReady',
              'activity:loading->dashboard#handleResourceLoading',
              'activity:ready->dashboard#handleResourceReady'].join(' ') }) do

  = spinner_html.html_safe

  .company__container.container-fluid

    = render(SidebarComponent.new( \
        'dashboard', active_tab:, collapsed: sidebar_collapsed)) do |component|
      - [ ['#visitors', 'fa-bar-chart', 'Visitors'],
          ['#activity', 'fa-line-chart', 'Recent Activity'] ] \
          .each do |panel_selector, icon_class, label_text|
        - component.with_tab( \
            panel_selector:,
            icon_class:,
            label_text:,
            data: { action: 'dashboard#setNavCookie', nav_list_target: 'tab' })

    .company__main
      .tab-content

        = tag.div(id: 'visitors',
                  class: "tab-pane #{'active in' if active_tab == '#visitors'}",
                  role: 'tabpanel',
                  aria_labelledby: 'visitors-tab',
                  data: { \
                    dashboard_target: 'visitors',
                    resource_name: 'visitors',
                    controller: 'visitors',
                    visitors_dashboard_outlet: '.dashboard',
                    visitors_data_path_value: company_visitors_path(company),
                    visitors_filters_value: @visitors_filters,
                    visitors_display_options_html_value: visitors_display_options_html(company) })
          = render('companies/measure/visitors', company:)

        = tag.div(id: 'activity',
                  class: "tab-pane #{'active in' if active_tab == '#activity'}",
                  role: 'tabpanel',
                  aria_labelledby: 'activity-tab',
                  data: { \
                    dashboard_target: 'activity',
                    resource_name: 'activity',
                    controller: 'activity',
                    activity_dashboard_outlet: '.dashboard',
                    activity_filters_value: { curator: curator&.id } })
          = render('companies/measure/activity')