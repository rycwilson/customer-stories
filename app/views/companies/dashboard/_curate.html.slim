= tag.div( \
    id: 'curate',
    class: "tab-pane #{'active' if workflow_stage == 'curate'}",
    data: { \
      dashboard_target: 'tabPanel',
      role: 'tabpanel',
      action: [ \
        'stories:loading->dashboard#onResourceLoading',
        'stories:ready->dashboard#onResourceReady'].join(' ') })

  = render('shared/loading_spinner')

  = tag.div( \
      class: 'container-fluid',
      data: { \
        controller: 'stories',
        dashboard_target: 'stories',
        action: [ \
          'tomselect:did-initialize->stories#onInitFilter',
          "#{%w[curator status customer category product].map do |filter| \
            "tomselect:change-#{filter}->stories#onChangeFilter"; end.join(' ')}" ].join(' ') })

    = render( \
        'stories/shared/search_and_filters_md_lg',
        { company: @company,
          filters_match_type: @filters_match_type,
          filters: @filters,
          is_dashboard: true })

    = turbo_frame_tag( \
        'stories', 
        src: '/' + "?#{URI.encode_www_form(@filters)}#{@filters.length > 1 ? '&match_type=' + @filters_match_type : ''}", 
        loading: 'lazy', 
        data: { stories_target: 'turboFrame' })