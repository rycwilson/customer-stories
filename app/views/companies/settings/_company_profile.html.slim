/ Turbo is disabled for company creation because its fetch-based form submission uses
/ credentials: "same-origin"; when the server's redirect crosses to the new subdomain (a
/ different origin), the browser drops the session cookie for that request, which looks
/ like a sign-out and bounces through /users/sign_in -> after_sign_in_path_for before
/ landing back on the new subdomain, still signed in.

- form = capture do
  = form_with( \
      model: company,
      id: 'company-profile-form',
      class: 'form-horizontal',
      data: { \
        turbo: (false if company.new_record?),
        controller: 'company-profile toast',
        toast_errors_value: (errors if defined? errors),
        action: [ \
          'submit->company-profile#validate',
          'turbo:submit-start->company-profile#onSubmitStart',
          'input->company-profile#updateState',
          'change->company-profile#updateState',
          'image-card:ready-to-validate->company-profile#updateValidator',
          'image-card:validated->company-profile#updateValidator',
          'image-card:upload-ready->company-profile#onUploadReady' ].join(' ') },
      html: { \
        autocomplete: 'off',
        novalidate: true }) do |form|
    
    .form-group
      .visible-sm-block.col-sm-12
        = form.label(:name, 'Company Name')
      = form.label(:name, 'Company Name', class: 'control-label col-md-3 visible-md-inline-block visible-lg-inline-block')
      .col-sm-12.col-md-8
        = form.text_field(:name, class: 'form-control', required: true, placeholder: 'Your company')
        .help-block.with-errors
    
    .form-group
      .visible-sm-block.col-sm-12
        = form.label(:website)
      = form.label( \
          :website,
          'Company Website',
          class: 'control-label col-md-3 visible-md-inline-block visible-lg-inline-block')
      .col-sm-12.col-md-8
        = form.text_field(:website, class: 'form-control', required: true, placeholder: "Your company's web address")
        .help-block.with-errors

    .form-group
      .visible-sm-block.col-sm-12
        = form.label(:subdomain)
      = form.label(:subdomain, 'Custom Domain', class: 'control-label col-md-3 visible-md-inline-block visible-lg-inline-block')
      .col-sm-12.col-md-8
        = form.text_field( \
            :subdomain,
            value: company.persisted? ? "#{form.object.subdomain}.customerstories.net" : '',
            class: 'form-control',
            required: true,
            placeholder: "your-custom-domain.customerstories.net",
            disabled: company.persisted?)
        .help-block.with-errors

    .form-group 
      .visible-sm-block.col-sm-12
        label Company Logos
      = form.label( \
          :description,
          'Company Logos',
          class: 'control-label col-md-3 visible-md-inline-block visible-lg-inline-block')
      .col-sm-12.col-md-8
        ul.company-logo-cards.list-unstyled
          li
            = render( \
                ImageCardComponent.new( \
                  'Company', 
                  image_data: { type: 'SquareLogo', url: company.square_logo_url }, 
                  required: true )) do
              = form.hidden_field( \
                  :square_logo_url,
                  disabled: true,
                  data: { image_card_target: 'input urlInput' })
          li 
            = render( \
                ImageCardComponent.new( \
                  'Company', 
                  image_data: { type: 'LandscapeLogo', url: company.landscape_logo_url } )) do
              = form.hidden_field( \
                  :landscape_logo_url,
                  disabled: true,
                  data: { image_card_target: 'input urlInput' })

    .row
      .visible-sm-block.col-sm-12
        label style="margin:0" Custom Header  
      label.control-label.col-md-3.visible-md-inline-block.visible-lg-inline-block Custom Header
      .col-sm-12.col-md-8 data-action="change->company-profile#onChangeHeaderLogoType"
        = label_tag('company_header_logo_type_squarelogo', class: 'radio-inline') do 
          = form.radio_button( \
              :header_logo_type,
              'SquareLogo',
              data: { company_profile_target: 'logoTypeRadio' })
          | Square Logo
        = label_tag('company_header_logo_type_landscapelogo', class: 'radio-inline') do
          = form.radio_button( \
              :header_logo_type,
              'LandscapeLogo',
              data: { company_profile_target: 'logoTypeRadio' })
          | Landscape Logo

    .row.custom-header-colors
      .col-sm-12.col-md-offset-3.col-md-8
        div
          = form.label(:header_color_1, 'Upper')
          = form.color_field( \
              :header_color_1,
              class: 'form-control',
              style: 'display:inline-block; width:34px; padding:0',
              data: { action: 'company-profile#onInputCompanyHeaderBackgroundColor' })
        div
          = form.label(:header_color_2, 'Lower')
          = form.color_field( \
              :header_color_2,
              class: 'form-control',
              style: 'display:inline-block; width:34px; padding:0',
              data: { action: 'company-profile#onInputStoriesHeaderBackgroundColor' })
        div
          = form.label(:header_text_color, 'Heading')
          = form.color_field(:header_text_color,
              class: 'form-control',
              style: 'display:inline-block; width:34px; padding:0',
              data: { \
                company_profile_target: 'storiesHeadingColorInput',
                action: 'company-profile#onInputStoriesHeadingColor' })

    .form-group
      .col-sm-12.col-md-offset-3.col-md-8
        .company-header-demo data-company-profile-target="companyHeaderDemo" style="background-color:#{company.header_color_1}"
          = tag.a( \
              href: 'javascript:;',
              class: class_names('LandscapeLogo', hidden: company.header_logo_type == 'SquareLogo'),
              data: { company_profile_target: 'logoDemo' })
            = image_tag( \
                company.landscape_logo_url || LOGO_PLACEHOLDER,
                class: company.landscape_logo_url.blank? ? 'generic' : '',
                alt: 'Company Logo')
          = tag.a( \
              href: 'javascript:;',
              class: class_names('SquareLogo', hidden: company.header_logo_type == 'LandscapeLogo'),
              data: { company_profile_target: 'logoDemo' })
            = image_tag( \
                company.square_logo_url || LOGO_PLACEHOLDER,
                class: company.square_logo_url.blank? ? 'generic' : '',
                alt: 'Company Logo')
        div {
          class="stories-header-demo stories-header-demo--bg-#{color_shade(company.header_color_2)}"
          data-company-profile-target="storiesHeaderDemo"
          style="#{stories_header_custom_colors(company)}" }
          h3 data-company-profile-target="storiesHeadingDemo"
            | Customer Stories

    /.form-group
      .visible-sm-block.col-sm-offset-1.col-sm-11
        = form.label(:gtm_id, 'Google Tag Manager ID')
      = form.label(:gtm_id, 'Google Tag Manager ID', class: 'control-label col-md-3 visible-md-inline-block visible-lg-inline-block')
      .col-sm-offset-1.col-sm-11.col-md-9.col-lg-6
        = form.text_field(:gtm_id, class: 'form-control')

    .row
      .col-sm-12.col-md-offset-3.col-md-8
        = tag.button( \
            class: 'form__submit btn btn-success',
            form: 'company-profile-form',
            # disabled: true,
            data: { \
              content: company.new_record? ? 'Create Account' : 'Save changes',
              company_profile_target: 'submitBtn',
              disable_with_html: disabled_submit_button_html })

- if company.persisted?
  = turbo_frame_tag('company-profile-frame')
    = form
- else 
  = form
